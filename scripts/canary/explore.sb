(version 1)
; The explorer's copy and everything it starts (zsh, git, fake agents): an
; agent drives it, so it reads and writes only the run's throwaway folder
; (WORK) and what macOS itself needs, and reaches no network but localhost,
; no clipboard, no other process's socket, no app through AppleEvents.
(allow default)
(deny file-read-data file-write*)
(deny network*)
(allow file-read-data
    (subpath "/System") (subpath "/usr") (subpath "/bin") (subpath "/sbin")
    (subpath "/Library") (subpath "/private/etc") (subpath "/private/var/db")
    (subpath "/dev") (literal "/") (literal "/private") (literal "/private/tmp"))
; git and xcrun from an Xcode install, not only from /Library's Command Line Tools.
(allow file-read-data (regex #"^/Applications/Xcode[^/]*\.app/"))
(allow file-read-data file-write* (subpath (param "WORK")))
(allow file-write* (subpath "/dev"))
; /usr/bin/git is an xcrun shim: its cache sits in the user's temp folder, whatever TMPDIR says.
(allow file-read-data file-write* (regex #"^/private/var/folders/[^/]+/[^/]+/T/xcrun_db(-[A-Za-z0-9]+)?$"))
; Nirux's own temp folder (Ghostty's generated config) and the fresh folder of each atomic save
; (state.json, the channel's answers): the user's temp folder, whatever TMPDIR says. TemporaryItems
; itself stays unlisted.
(allow file-read-data file-write*
    (regex #"^/private/var/folders/[^/]+/[^/]+/T/com\.xikimay\.nirux(/|$)")
    (regex #"^/private/var/folders/[^/]+/[^/]+/T/TemporaryItems/NSIRD_Nirux_[^/]+(/|$)"))
; Sockets of the copy's own, under WORK; none of the user's (ssh-agent, launchd listeners).
(allow network* (local unix-socket (subpath (param "WORK"))) (remote unix-socket (subpath (param "WORK"))))
(allow network-outbound (remote ip "localhost:*"))
(allow network-bind network-inbound (local ip "localhost:*"))
; The user's clipboard, AppleEvents to other apps, and the tools that reach past the copy.
(deny mach-lookup (global-name "com.apple.pasteboard.1"))
(deny appleevent-send)
(deny process-exec
    (literal "/bin/launchctl") (literal "/usr/bin/open") (literal "/usr/bin/osascript")
    (literal "/usr/bin/ssh") (literal "/usr/bin/ssh-add") (literal "/usr/bin/security")
    (literal "/usr/bin/pbcopy") (literal "/usr/bin/pbpaste"))
